# Optional: compatible local chat-completions service. Do not put secrets in HTML.
HCT_LLM_BASE_URL=http://127.0.0.1:11434/v1
HCT_LLM_MODEL=your-local-model
# HCT_LLM_API_KEY=
# Remote HTTPS endpoints require this explicit opt-in. Local is the default.
# HCT_ALLOW_REMOTE_LLM=1

# Optional: absolute Python path with pypdf installed; auto-detected when omitted.
# HCT_DOCUMENT_PYTHON=C:/path/to/.venv-documents/Scripts/python.exe
